{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sheetly",
  "version": "0.1.0",
  "identifier": "app.sheetly.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Book1 - Sheetly",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 420,
        "decorations": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["xlsx"], "name": "Spreadsheet", "description": "Excel workbook", "role": "Editor" },
      { "ext": ["csv"], "name": "Spreadsheet", "description": "CSV file", "role": "Editor" },
      { "ext": ["sheetly"], "name": "Spreadsheet", "description": "Sheetly workbook", "role": "Editor" }
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
